        version = "0.5.12";
        edition = "2021";
        sha256 = "1zipxj775zwgnvarcx66w7x688f3v6wgsb0whgihkirlyv79w3j1";
        libName = "zune_jpeg";
        authors = [
          "caleb <etemesicaleb@gmail.com>"
        ];
        dependencies = [
          {
            name = "zune-core";
            packageId = "zune-core 0.5.1";
          }
        ];
        features = {
          "default" = [ "x86" "neon" "std" ];
          "log" = [ "zune-core/log" ];
          "std" = [ "zune-core/std" ];
        };
        resolvedDefaultFeatures = [ "default" "neon" "std" "x86" ];
